{
  "name": "home-monorepo",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run site:dev",
    "home:dev": "bun run --cwd apps/home dev",
    "home:typecheck": "bun run --cwd apps/home typecheck",
    "home:test": "bun run --cwd apps/home test",
    "home:build": "bun run --cwd apps/home build",
    "home:e2e": "bun run --cwd apps/home e2e",
    "site:dev": "bun run --cwd apps/site dev",
    "site:typecheck": "bun run --cwd apps/site typecheck",
    "site:lint": "bun run --cwd apps/site lint",
    "site:build": "bun run --cwd apps/site build",
    "typecheck": "bun run home:typecheck && bun run site:typecheck",
    "test": "bun run home:test",
    "build": "bun run home:build && bun run site:build",
    "ci": "bun run typecheck && bun run test && bun run site:lint && bun run site:build"
  }
}
